
# ==========================================
# DEPENDENCIES
# ==========================================
node_modules/

# ==========================================
# ENVIRONMENT VARIABLES AND SECRETS
# ==========================================
.env
.env.*
!.env.example

# ==========================================
# BUILD OUTPUT
# ==========================================
dist/
build/
coverage/
.vite/

# ==========================================
# LOGS AND DEBUG OUTPUT
# ==========================================
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ==========================================
# UPLOADS AND USER-GENERATED FILES
# ==========================================
backend/uploads/*
!backend/uploads/.gitkeep

backend/logs/
uploads/

# ==========================================
# COOKIES AND LOCAL SESSION DATA
# ==========================================
cookies.txt
cookie-jar=cookies.txt
**/cookies.txt
**/cookie-jar=cookies.txt

# ==========================================
# DATABASE DUMPS AND LOCAL OUTPUT
# ==========================================
*.dump
*.bak
*.sqlite
*.sqlite3

# ==========================================
# OPERATING SYSTEM FILES
# ==========================================
.DS_Store
Thumbs.db

# ==========================================
# EDITOR AND IDE FILES
# ==========================================
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/

# ==========================================
# TYPESCRIPT BUILD CACHE
# ==========================================
*.tsbuildinfo
# Sensitive and temporary files
**/cookies.txt
**/cookie-jar=cookies.txt
**/*_log.txt
**/*_dump.txt
**/*_out.txt
TEMP_KEEP.txt
*.tsbuildinfo